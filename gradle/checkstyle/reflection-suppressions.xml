<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
  The two places the Jakarta EL API leaves no choice: both declare `java.lang.reflect.Method` because the
  interface they implement declares it, and neither reads a class. `FunctionMapper.resolveFunction` returns a
  `Method`, and so does the map of `ExpressionFactory.getInitFunctionMap`. Both implementations here are
  empty: one returns null, the other an empty map, so the type is named and never used.

  Nothing else is suppressed. A new entry means the runtime gained a reflective path, which is the thing this
  check exists to make visible.
-->
<suppressions>
    <suppress id="ReflectionImport" files="[\\/]el[\\/]CompiledELContext\.java$"/>
    <suppress id="ReflectionQualifiedName" files="[\\/]el[\\/]CompiledELContext\.java$"/>
    <suppress id="ReflectionImport" files="[\\/]el[\\/]CompiledExpressionFactory\.java$"/>
    <suppress id="ReflectionQualifiedName" files="[\\/]el[\\/]CompiledExpressionFactory\.java$"/>

    <!--
      The sandbox names the reflective packages in order to deny them: the strings are the list of what an
      expression parsed at runtime may not reach, which is the opposite of using it.
    -->
    <suppress id="ReflectionQualifiedName" files="[\\/]el[\\/]ELSandbox\.java$"/>
</suppressions>
